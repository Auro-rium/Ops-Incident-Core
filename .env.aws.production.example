# AWS production contract. Terraform injects secrets from Secrets Manager;
# never copy credentials into this file.
APP_ENV=production
CLOUD_PROVIDER=aws
AWS_REGION=us-east-1
DB_CREATE_ALL=false
DB_REQUIRE_MIGRATIONS=true
ALLOW_LOCAL_SEED_ADMIN=false
DEMO_MODE_PUBLIC=false
ALLOW_DEMO_PROJECT_BYPASS=false
LOCAL_INGEST_ENABLED=false
ALLOW_LOCAL_MODEL_LOADING=false

DATABASE_URL=from-secrets-manager
REDIS_URL=from-secrets-manager
JWT_SECRET=from-secrets-manager
QDRANT_URL=http://qdrant.incidentops-production.internal:6333
QDRANT_API_KEY=from-secrets-manager
QDRANT_COLLECTION=incidentops_chunks
RETRIEVAL_BACKEND=qdrant
VECTOR_INDEX_VERSION=aws-v1

WORKER_MODE=queue
JOB_QUEUE_BACKEND=redis
RATE_LIMIT_BACKEND=redis
METRICS_BACKEND=prometheus
METRICS_PUBLIC=false

REQUIRE_AZURE_OPENAI=false
REQUIRE_AWS_MODELS=true
EMBEDDING_MODEL=aws-bedrock-titan-v2
EMBEDDING_DIM=1024
BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

RAG_GPU_ENDPOINT_REQUIRED=false
SAGEMAKER_RERANKER_ENDPOINT_NAME=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_MODEL_REVISION=replace-with-immutable-model-revision
RAG_RERANK_MODE=disabled
RAG_REMOTE_AUTH_MODE=aws_iam
RAG_ASYNC_INDEXING=true
RAG_CACHE_ENABLED=true

CORS_ALLOW_ORIGINS=https://incidentops.example.com
ALLOW_WILDCARD_CORS=false
MCP_ENABLED=true
MCP_CORE_API_URL=http://api.incidentops-production.internal:8000
MCP_TOKEN=from-secrets-manager
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8080
