# Copy to deploy/ec2/.env.demo. scripts/deploy_ec2_demo.sh can generate
# strong values for POSTGRES_PASSWORD, JWT_SECRET, and BOOTSTRAP_ADMIN_PASSWORD.

COMPOSE_PROJECT_NAME=incidentops-demo

PUBLIC_BASE_URL=http://YOUR_EC2_PUBLIC_DNS_OR_IP
FRONTEND_URL=http://YOUR_EC2_PUBLIC_DNS_OR_IP
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_INCIDENTOPS_API_URL=/api
NEXT_PUBLIC_COLLECTOR_HEALTH_URL=/collector/health
NEXT_PUBLIC_COLLECTOR_METRICS_URL=/collector/metrics

POSTGRES_USER=incidentops
POSTGRES_PASSWORD=replace-with-generated-password
POSTGRES_DB=incidentops
DATABASE_URL=postgresql+asyncpg://incidentops:replace-with-generated-password@postgres:5432/incidentops

REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-generated-jwt-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=incidentops
JWT_AUDIENCE=incidentops-api
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BOOTSTRAP_ADMIN_EMAIL=admin@incidentops.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-generated-admin-password
BOOTSTRAP_ADMIN_NAME=IncidentOps Demo Admin

APP_ENV=production
DB_CREATE_ALL=false
DB_REQUIRE_MIGRATIONS=true

WORKER_MODE=queue
JOB_QUEUE_BACKEND=redis
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
METRICS_BACKEND=prometheus
METRICS_PUBLIC=false
ENABLE_OTEL=false

LOCAL_INGEST_ENABLED=false
ENABLE_LOCAL_INGEST=false
LOCAL_INGEST_ALLOWED_ROOTS=/disabled
EVAL_CASES_ALLOWED_ROOTS=/disabled

DEMO_MODE_PUBLIC=false
ALLOW_DEMO_PROJECT_BYPASS=false
ALLOW_LOCAL_SEED_ADMIN=false

CORS_ALLOW_ORIGINS=http://YOUR_EC2_PUBLIC_DNS_OR_IP
CORS_ORIGINS=http://YOUR_EC2_PUBLIC_DNS_OR_IP
ALLOW_WILDCARD_CORS=false

EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIM=384
RERANKER_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

MAX_QUERY_LENGTH=4096
MAX_TOP_K=20
MAX_RETRIEVED_CHUNKS=20
MAX_DOCUMENTS_PER_BATCH=100
MAX_DOCUMENT_BYTES=2000000
MAX_BATCH_BYTES=10000000
MAX_CHUNKS_PER_DOCUMENT=500
MAX_METADATA_BYTES=64000
MAX_EXTERNAL_ID_LENGTH=1024
MAX_PATH_LENGTH=2048
MAX_CONTEXT_TOKENS=12000
MAX_SYNC_DIAGNOSTICS_BYTES=64000

WORKFLOW_NODE_TIMEOUT_SECONDS=60
WORKFLOW_MAX_RETRIES=1
WORKFLOW_RUN_TIMEOUT_SECONDS=300
EVAL_RUN_TIMEOUT_SECONDS=600
JOB_POLL_INTERVAL_SECONDS=2

COLLECTOR_REPO_PATH=../Ops-Incident-Collector
FRONTEND_REPO_PATH=../Ops-Incident-frontend
COLLECTOR_SOURCE_NAME=ec2-demo-fixture
COLLECTOR_HEALTH_URL=http://collector:8686/health
COLLECTOR_METRICS_URL=http://collector:8687/metrics
