# ── Database ──
DATABASE_URL=postgresql+asyncpg://incidentops:incidentops@localhost:5432/incidentops
APP_ENV=local
DB_CREATE_ALL=false
DB_REQUIRE_MIGRATIONS=true

# ── Embedding ──
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIM=384

# ── LLM (OpenAI-compatible) ──
# Leave blank to run in evidence-only mode (no LLM answer generation)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ── Retrieval tuning ──
VECTOR_WEIGHT=0.45
LEXICAL_WEIGHT=0.35
METADATA_WEIGHT=0.20
DEFAULT_TOP_K=10

# ── Reranker (optional) ──
# Set to empty to use score-fusion fallback
RERANKER_MODEL=

# ── Server ──
HOST=0.0.0.0
PORT=8000

# ── Auth ──
AUTH_SECRET=incidentops-dev-secret
AUTH_TOKEN_TTL_SECONDS=3600

# ── Limits ──
USER_REQUEST_LIMIT=30
PROJECT_INGESTION_LIMIT=20
MAX_QUERY_LENGTH=4096
MAX_RETRIEVED_CHUNKS=20
MAX_CONTEXT_TOKENS=12000
GRAPH_TIMEOUT_SECONDS=120

# ── Demo ──
DEMO_MODE_PUBLIC=false
