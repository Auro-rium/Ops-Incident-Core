# ── Database ──
# This value is for the Docker Compose API/worker containers. Host-run commands
# need an explicit localhost URL that matches POSTGRES_PORT instead.
DATABASE_URL=postgresql+asyncpg://incidentops:incidentops@postgres:5432/incidentops
APP_ENV=local
DB_CREATE_ALL=false
DB_REQUIRE_MIGRATIONS=true

# ── Embedding ──
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIM=384

# ── Vector retrieval ──
RETRIEVAL_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=incidentops_chunks
VECTOR_INDEX_VERSION=current

# ── LLM (OpenAI-compatible) ──
# Leave blank to run in evidence-only mode (no LLM answer generation)
CLOUD_PROVIDER=nvidia
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ── NVIDIA NIM-compatible provider ──
NVIDIA_API_KEY=
NVIDIA_CHAT_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_EMBEDDING_ENDPOINT=https://integrate.api.nvidia.com/v1/embeddings
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# ── Azure OpenAI / Foundry ──
# Required in staging/production. Tests can keep local-hash/no-key settings.
REQUIRE_AZURE_OPENAI=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ── Retrieval tuning ──
VECTOR_WEIGHT=0.40
LEXICAL_WEIGHT=0.30
METADATA_WEIGHT=0.20
RAG_GRAPH_WEIGHT=0.10
RAG_RRF_K=60
RAG_BRANCH_TIMEOUT_SECONDS=2
RAG_RERANK_MODE=conditional
RAG_RERANK_MAX_CANDIDATES=20
RAG_RERANK_MAX_CHARS_PER_CANDIDATE=1600
RAG_RERANK_MAX_QUERY_CHARS=2048
DEFAULT_TOP_K=10

# ── Reranker (optional) ──
# Set to empty to use score-fusion fallback
RERANKER_MODEL=

# ── Server ──
HOST=0.0.0.0
PORT=8000

# ── Auth ──
JWT_SECRET=incidentops-local-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=incidentops
JWT_AUDIENCE=incidentops-api
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_LOCAL_SEED_ADMIN=true

# ── Limits ──
USER_REQUEST_LIMIT=30
PROJECT_INGESTION_LIMIT=20
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_DATABASE=0
MAX_QUERY_LENGTH=4096
MAX_TOP_K=20
MAX_RETRIEVED_CHUNKS=20
MAX_DOCUMENTS_PER_BATCH=100
MAX_DOCUMENT_BYTES=2000000
MAX_BATCH_BYTES=10000000
MAX_CHUNKS_PER_DOCUMENT=500
MAX_METADATA_BYTES=64000
MAX_EXTERNAL_ID_LENGTH=1024
MAX_PATH_LENGTH=2048
MAX_CONTEXT_TOKENS=12000
MAX_SYNC_DIAGNOSTICS_BYTES=64000
GRAPH_TIMEOUT_SECONDS=120

# ── Runtime / workers ──
WORKER_MODE=inline
JOB_QUEUE_BACKEND=inline
WORKFLOW_NODE_TIMEOUT_SECONDS=60
WORKFLOW_MAX_RETRIES=1
WORKFLOW_RUN_TIMEOUT_SECONDS=300
EVAL_RUN_TIMEOUT_SECONDS=600
JOB_POLL_INTERVAL_SECONDS=2
WORKER_JOB_MAX_RETRIES=2
OPERATIONAL_AGENT_TIMEOUT_SECONDS=180
OBSERVER_SYNC_WINDOW=20
OBSERVER_PARSER_ERROR_RATE_THRESHOLD=0.10
OBSERVER_MIN_EVAL_RECALL=0.60
OBSERVER_MAX_WRONG_SOURCE_TYPE_RATE=0.25
OBSERVER_EVAL_P95_LATENCY_MS=1500
LOGGING_AGGREGATE_EVENT_LIMIT=500

# ── Observability ──
ENABLE_OTEL=false
OTEL_SERVICE_NAME=incidentops-core
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_BACKEND=memory
METRICS_PUBLIC=false

# ── Local/dev path access ──
LOCAL_INGEST_ENABLED=true
LOCAL_INGEST_ALLOWED_ROOTS=.,/tmp
EVAL_CASES_ALLOWED_ROOTS=.,/tmp
MAX_EVAL_CASES_BYTES=1000000

# ── Demo ──
DEMO_MODE_PUBLIC=false
ALLOW_DEMO_PROJECT_BYPASS=true

# ── CORS ──
CORS_ALLOW_ORIGINS=*
ALLOW_WILDCARD_CORS=true

# ── MCP server ──
MCP_CORE_API_URL=http://127.0.0.1:8000
MCP_TOKEN=
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8080
MCP_PATH=/mcp
