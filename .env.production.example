# IncidentOps Core Azure production environment example.
# Store real values in Azure Key Vault; do not commit populated secrets.

APP_ENV=production
DB_CREATE_ALL=false
DB_REQUIRE_MIGRATIONS=true

# Inject from Azure Key Vault / Container Apps secrets.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@POSTGRES_FQDN:5432/incidentops?ssl=require
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_SSL=true
REDIS_DATABASE=0
JWT_SECRET=replace-with-key-vault-value
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-key-vault-value
LLM_API_KEY=

JWT_ALGORITHM=HS256
JWT_ISSUER=incidentops
JWT_AUDIENCE=incidentops-api
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_LOCAL_SEED_ADMIN=false

WORKER_MODE=queue
JOB_QUEUE_BACKEND=redis
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_WINDOW_SECONDS=60

METRICS_BACKEND=prometheus
METRICS_PUBLIC=false
ENABLE_OTEL=false
OTEL_SERVICE_NAME=incidentops-core
OTEL_EXPORTER_OTLP_ENDPOINT=

LOCAL_INGEST_ENABLED=false
ENABLE_LOCAL_INGEST=false
LOCAL_INGEST_ALLOWED_ROOTS=/disabled
EVAL_CASES_ALLOWED_ROOTS=/disabled
MAX_EVAL_CASES_BYTES=1000000

DEMO_MODE_PUBLIC=false
ALLOW_DEMO_PROJECT_BYPASS=false

CORS_ALLOW_ORIGINS=https://your-frontend.example.com
CORS_ORIGINS=https://your-frontend.example.com
ALLOW_WILDCARD_CORS=false

REQUIRE_AZURE_OPENAI=true
EMBEDDING_MODEL=azure-openai
RAG_RETRIEVAL_VERSION=v1
RAG_INDEX_VERSION=v1
RAG_EMBEDDING_DIM=1024
RAG_MODEL_REVISION=
RAG_GPU_ENDPOINT_REQUIRED=false
RAG_EMBEDDING_ENDPOINT=
RAG_RERANKER_ENDPOINT=
RAG_REMOTE_API_KEY=
RAG_REMOTE_AUTH_MODE=managed_identity
RAG_RERANK_MODE=conditional
RAG_STREAMING_ENABLED=true
RAG_SHADOW_PERCENT=0
RAG_CANDIDATE_MULTIPLIER=3
RAG_REMOTE_TIMEOUT_SECONDS=15
RAG_PARALLEL_RETRIEVAL=true
RAG_ASYNC_INDEXING=true
RAG_INDEX_MAX_RETRIES=3
RAG_INDEX_DISPATCH_BATCH_SIZE=50
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=3600
ALLOW_LOCAL_MODEL_LOADING=false
EMBEDDING_DIM=384
RERANKER_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Required Azure OpenAI / Foundry model deployment.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-key-vault-value
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=your-chat-deployment
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment

# MCP server process.
MCP_CORE_API_URL=https://your-core-api-url
MCP_TOKEN=replace-with-core-access-token
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_PATH=/mcp

MAX_QUERY_LENGTH=4096
MAX_TOP_K=20
MAX_RETRIEVED_CHUNKS=20
MAX_DOCUMENTS_PER_BATCH=100
MAX_DOCUMENT_BYTES=2000000
MAX_BATCH_BYTES=10000000
MAX_CHUNKS_PER_DOCUMENT=500
MAX_METADATA_BYTES=64000
MAX_EXTERNAL_ID_LENGTH=1024
MAX_PATH_LENGTH=2048
MAX_CONTEXT_TOKENS=12000
MAX_SYNC_DIAGNOSTICS_BYTES=64000

WORKFLOW_NODE_TIMEOUT_SECONDS=60
WORKFLOW_MAX_RETRIES=1
WORKFLOW_RUN_TIMEOUT_SECONDS=300
EVAL_RUN_TIMEOUT_SECONDS=600
JOB_POLL_INTERVAL_SECONDS=2
