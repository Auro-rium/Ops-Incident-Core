# IncidentOps Core production environment example.
# Store real values in AWS Secrets Manager; do not commit populated secrets.

APP_ENV=production
DB_CREATE_ALL=false
DB_REQUIRE_MIGRATIONS=true

# Inject from Secrets Manager in ECS.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@RDS_ENDPOINT:5432/incidentops
REDIS_URL=redis://ELASTICACHE_ENDPOINT:6379/0
JWT_SECRET=replace-with-secrets-manager-value
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-secrets-manager-value
LLM_API_KEY=

JWT_ALGORITHM=HS256
JWT_ISSUER=incidentops
JWT_AUDIENCE=incidentops-api
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_LOCAL_SEED_ADMIN=false

WORKER_MODE=queue
JOB_QUEUE_BACKEND=redis
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_WINDOW_SECONDS=60

METRICS_BACKEND=prometheus
METRICS_PUBLIC=false
ENABLE_OTEL=false
OTEL_SERVICE_NAME=incidentops-core
OTEL_EXPORTER_OTLP_ENDPOINT=

LOCAL_INGEST_ENABLED=false
ENABLE_LOCAL_INGEST=false
LOCAL_INGEST_ALLOWED_ROOTS=/disabled
EVAL_CASES_ALLOWED_ROOTS=/disabled
MAX_EVAL_CASES_BYTES=1000000

DEMO_MODE_PUBLIC=false
ALLOW_DEMO_PROJECT_BYPASS=false

CORS_ALLOW_ORIGINS=https://your-frontend.example.com
CORS_ORIGINS=https://your-frontend.example.com
ALLOW_WILDCARD_CORS=false

EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIM=384
RERANKER_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

MAX_QUERY_LENGTH=4096
MAX_TOP_K=20
MAX_RETRIEVED_CHUNKS=20
MAX_DOCUMENTS_PER_BATCH=100
MAX_DOCUMENT_BYTES=2000000
MAX_BATCH_BYTES=10000000
MAX_CHUNKS_PER_DOCUMENT=500
MAX_METADATA_BYTES=64000
MAX_EXTERNAL_ID_LENGTH=1024
MAX_PATH_LENGTH=2048
MAX_CONTEXT_TOKENS=12000
MAX_SYNC_DIAGNOSTICS_BYTES=64000

WORKFLOW_NODE_TIMEOUT_SECONDS=60
WORKFLOW_MAX_RETRIES=1
WORKFLOW_RUN_TIMEOUT_SECONDS=300
EVAL_RUN_TIMEOUT_SECONDS=600
JOB_POLL_INTERVAL_SECONDS=2
