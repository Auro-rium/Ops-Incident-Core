aws_region        = "us-east-1"
name_prefix       = "incidentops"
environment       = "production"
cors_origins      = "https://incidentops.example.com"
certificate_arn   = ""

core_image_tag     = "replace-with-git-sha"
frontend_image_tag = "replace-with-git-sha"
reranker_image_tag = "replace-with-git-sha"

bedrock_chat_model_id      = "us.anthropic.claude-haiku-4-5-20251001-v1:0"
bedrock_embedding_model_id = "amazon.titan-embed-text-v2:0"
embedding_dimension        = 1024

# Set true only after a pinned reranker image is in ECR and the GPU cost is approved.
enable_sagemaker_reranker  = false
reranker_model_id          = "BAAI/bge-reranker-v2-m3"
reranker_model_revision    = "replace-with-immutable-hugging-face-commit"
sagemaker_instance_type    = "ml.g5.xlarge"

api_desired_count       = 2
worker_desired_count    = 1
frontend_desired_count  = 2
collector_desired_count = 0
mcp_desired_count       = 0

# Collector and MCP remain at zero until project-scoped tokens are supplied as
# sensitive TF_VAR_collector_access_token / TF_VAR_mcp_access_token values.
collector_project_id = ""
collector_repo_url   = ""

database_deletion_protection = true
database_skip_final_snapshot = false
budget_alert_email            = "platform@example.com"
monthly_budget_usd            = 300
