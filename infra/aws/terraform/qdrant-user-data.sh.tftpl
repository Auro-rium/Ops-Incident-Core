#!/usr/bin/env bash
set -euo pipefail

dnf install -y docker jq
systemctl enable --now docker

device=""
for candidate in /dev/nvme1n1 /dev/xvdb; do
  if [ -b "$candidate" ]; then
    device="$candidate"
    break
  fi
done
if [ -z "$device" ]; then
  echo "Qdrant data volume is not attached" >&2
  exit 1
fi

if ! blkid "$device" >/dev/null 2>&1; then
  mkfs.xfs "$device"
fi
mkdir -p /var/lib/qdrant /etc/incidentops
mount "$device" /var/lib/qdrant
grep -q '/var/lib/qdrant' /etc/fstab || echo "UUID=$(blkid -s UUID -o value "$device") /var/lib/qdrant xfs defaults,nofail 0 2" >> /etc/fstab

secret_json="$(aws secretsmanager get-secret-value --region '${aws_region}' --secret-id '${runtime_secret_id}' --query SecretString --output text)"
umask 077
printf 'QDRANT__SERVICE__API_KEY=%s\n' "$(jq -r '.qdrant_api_key' <<<"$secret_json")" > /etc/incidentops/qdrant.env
unset secret_json

docker pull '${qdrant_image}'
docker rm -f incidentops-qdrant >/dev/null 2>&1 || true
docker run -d \
  --name incidentops-qdrant \
  --restart unless-stopped \
  --env-file /etc/incidentops/qdrant.env \
  --log-driver awslogs \
  --log-opt awslogs-region='${aws_region}' \
  --log-opt awslogs-group='${log_group_name}' \
  --log-opt awslogs-stream=instance \
  -p 6333:6333 \
  -v /var/lib/qdrant:/qdrant/storage \
  '${qdrant_image}'
